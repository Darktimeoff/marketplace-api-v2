# HTTP port the Nest app listens on
PORT=3000
DBHOST=localhost
DBPORT=33310
DBNAME=api
INFISICAL_ENVIRONMENT=dev
INFISICAL_AUTH_METHOD=universal
INFISICAL_CLIENT_ID=x
INFISICAL_IDENTITY_ID=
INFISICAL_JWT_PATH=/var/run/secrets/infisical/token
INFISICAL_SITE_URL=http://localhost:4010
INFISICAL_PROJECT_ID=x
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
KAFKA_BROKERS=localhost:9092
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6380
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6381
KAFKA_CONSUMERS_ENABLED=true
ACCESS_DENYLIST_FAIL_OPEN=true
OUTBOX_RELAY_INTERVAL_MS=1000
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_CLIENT_ID=x
OIDC_REDIRECT_BASE_URL=http://localhost:3000
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=us-east-1
STORAGE_BUCKET=marketplace-media
MEDIA_PUBLIC_BASE_URL=http://localhost:8088
DRAIN_MS=5000
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
TLS_MODE=disable
TLS_CA_PATH=
KAFKA_SASL_MECHANISM=none
TEMPORAL_AUTH=none
STORAGE_AUTH=keys
