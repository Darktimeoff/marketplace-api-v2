# Нічний бекап бази курсового. Встановити: crontab -l | { cat; cat backup.cron; } | crontab -
# Шлях і оточення підлаштувати під ту машину, де стоїть crontab.
30 2 * * * cd /home/ykorolikhin/my_project/marketplace-api-v2 && DBHOST=localhost DBPORT=5500 DBNAME=api DBUSER=root PGPASSWORD="$(cat secrets/db_password.txt)" BACKUP_DIR=/home/ykorolikhin/my_project/marketplace-api-v2/backups ./scripts/backup.sh >> /home/ykorolikhin/my_project/marketplace-api-v2/backups/backup.log 2>&1
